{
  "name": "phap-mon-tam-linh-web",
  "version": "1.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "author": {
    "name": "Vinh Developer",
    "email": "Vinhhuutran.developer@gmail.com",
    "url": "https://github.com/tranhuuvinh1109"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- next dev --turbopack",
    "build": "next build",
    "build:local": "dotenv -e .env.prod -- next build",
    "start": "dotenv -e .env.prod -- next start",
    "pages:build": "next build",
    "pages:deploy": "npx wrangler pages deploy",
    "pages:dev": "npx wrangler pages dev",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare build && wrangler deploy",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "lint:fix": "next lint --fix",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "test": "vitest run",
    "clear-cache": "rm -rf .next && bun install --no-cache && bun run dev"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings 0 --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@next/third-parties": "^16.4.2",
    "@opennextjs/cloudflare": "^1.20.12",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.509.0",
    "next": "^16.3.0",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "3.11.174",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.1",
    "react-pageflip": "^2.0.3",
    "react-quill-new": "^3.8.3",
    "tailwind-merge": "^3.2.0",
    "youtube-transcript": "^1.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.151.1"
  }
}
